#!/bin/bash
# summary: muestra qué servicios locales están corriendo (Ollama, OpenWebUI, SearXNG)
#==============================================================================
# chati --status — one glance at the local AI services.
#
# Ollama starts on its own when you launch chati; SearXNG starts on its own when
# you use /web; OpenWebUI is the one you start by hand (`chati --webui`). This just
# reports which are up — it never starts anything. Pure bash + curl + jq.
#==============================================================================
set -o pipefail

# Resolve the real repo dir (follow symlinks) so it works from a PATH symlink.
_src="${BASH_SOURCE[0]}"
while [[ -L "$_src" ]]; do
    _dir="$(cd -P "$(dirname "$_src")" && pwd)"; _src="$(readlink "$_src")"
    [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
CHATI_DIR="$(cd -P "$(dirname "$_src")/.." && pwd)"
unset _src _dir
# shellcheck source=/dev/null
source "$CHATI_DIR/chati-common.sh"

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    echo "Usage: chati --status"
    echo "Report which local AI services are running (Ollama, OpenWebUI, SearXNG)."
    exit 0
fi

chati_load_env

# --- Ollama (a LOCAL one auto-starts with chati; a remote one does not) ---
if chati_ollama_is_remote; then
    # Remote endpoint: a local process check is meaningless; report reachability.
    # Classify first so a 403 (server up, Host header rejected) doesn't read as
    # a dead box — that distinction is the difference between "start Ollama" and
    # "use the short hostname/IP".
    api="$(chati_ollama_api)"
    case "$(chati_ollama_probe "$api")" in
        ok)
            ver=$(curl -fsS --max-time 2 "$api/api/version" 2>/dev/null | jq -r '.version // empty' 2>/dev/null)
            echo "Ollama:    REACHABLE  (remote $api${ver:+, v$ver})"
            ;;
        forbidden)
            echo "Ollama:    403 forbidden  (remote $api answers but rejects the Host header)"
            echo "                          Ollama bound to loopback only accepts an IP, localhost, or the short hostname."
            echo "                          Point at the short name or the 100.x Tailscale IP, not the full *.ts.net name."
            ;;
        *)
            echo "Ollama:    unreachable  (remote $api — switch with /host, or /host local)"
            ;;
    esac
elif chati_svc_running "$CHATI_OLLAMA_PROC"; then
    ver=$(curl -fsS --max-time 2 "$(chati_ollama_api)/api/version" 2>/dev/null | jq -r '.version // empty' 2>/dev/null)
    echo "Ollama:    RUNNING${ver:+  (v$ver)}"
else
    echo "Ollama:    stopped   (starts on its own when you launch chati)"
fi

# --- OpenWebUI (the one you start by hand) ---
if chati_svc_running "$CHATI_WEBUI_PROC"; then
    echo "OpenWebUI: RUNNING   (http://${WEBUI_HOST:-127.0.0.1}:${WEBUI_PORT:-8888})"
else
    echo "OpenWebUI: stopped   (start it with: chati --webui)"
fi

# --- SearXNG (/web backend) ---
# Report the endpoint /web will ACTUALLY use. A configured SEARXNG_URLS (a system
# SearXNG, or a remote one) wins over the bundled instance on 8890 — on a box
# whose SearXNG is a systemd service, the bundled process never runs even though
# search works, so keying the status off that process alone was misleading.
_sx_first=$(chati_searxng_urls | head -1)
if [[ -n "$_sx_first" ]]; then
    _sx_count=$(chati_searxng_urls | grep -c .)
    _sx_code=$(curl -s -o /dev/null --max-time 3 -G \
        --data-urlencode "q=ping" --data-urlencode "format=json" \
        -w '%{http_code}' "$_sx_first/search" 2>/dev/null)
    case "$_sx_code" in
        2*|429|503) _sx_state="reachable" ;;
        *)          _sx_state="unreachable (HTTP ${_sx_code:-000})" ;;
    esac
    if (( _sx_count > 1 )); then
        echo "SearXNG:   configured ($_sx_count endpoints) — first $_sx_first [$_sx_state]"
    else
        echo "SearXNG:   configured ($_sx_first) — $_sx_state"
    fi
elif chati_svc_running "$CHATI_SEARXNG_PROC"; then
    echo "SearXNG:   RUNNING   (http://${CHATI_SEARXNG_HOST:-127.0.0.1}:${CHATI_SEARXNG_PORT:-8890})"
elif chati_searxng_installed; then
    echo "SearXNG:   stopped   (local instance on :${CHATI_SEARXNG_PORT:-8890}, starts on its own when you use /web)"
else
    echo "SearXNG:   not configured   (set SEARXNG_URLS in .env, or install a local one; /web needs a backend)"
fi
